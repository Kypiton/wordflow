{
  "name": "wordflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "telegram:webhook": "node --env-file=.env.local scripts/register-telegram-webhook.mjs",
    "test:telegram": "tsc --strict --module commonjs --moduleResolution node --target es2022 --esModuleInterop --skipLibCheck --outDir .next/telegram-tests src/app/api/telegram/webhook/route.ts && node --conditions=react-server --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:compile": "tsc -p tsconfig.database.json",
    "db:seed": "npm run db:compile && prisma db seed",
    "postinstall": "prisma generate",
    "test:db": "npm run db:compile && node scripts/test-database.mjs",
    "db:test:migrate": "node scripts/test-database.mjs migrate",
    "db:test:status": "node scripts/test-database.mjs status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
