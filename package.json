{
  "name": "wordflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "telegram:webhook": "node --env-file=.env.local scripts/register-telegram-webhook.mjs",
    "test:telegram": "tsc --strict --module commonjs --moduleResolution node --target es2022 --esModuleInterop --skipLibCheck --outDir .next/telegram-tests src/app/api/telegram/webhook/route.ts && node --conditions=react-server --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
