generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model TelegramUser {
  id        BigInt         @id
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  vocabularyMode VocabularyMode @default(GENERAL)
  cefrLevel CefrLevel?
  vocabularyWindowAt DateTime? @db.Timestamptz(3)
  vocabularyRequestCount Int @default(0)
  personalWords PersonalWord[]
  vocabularyDraft VocabularyDraft?
  vocabularyReceipts VocabularyReceipt[]
  sessions  StudySession[]
  progress  UserWordProgress[]
}

// Published word versions are immutable, so existing attempts keep their meaning.
model Word {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @db.VarChar(80)
  version      Int           @default(1)
  term         String        @db.VarChar(80)
  partOfSpeech String        @db.VarChar(40)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  cefrLevel CefrLevel?
  personalWordId String? @db.Uuid
  personalWord PersonalWord? @relation(fields: [personalWordId], references: [id], onDelete: Restrict)
  isCurrent Boolean @default(true)
  translation String? @db.VarChar(120)
  example String? @db.VarChar(160)
  options      WordOption[]
  items        SessionItem[]
  progress     UserWordProgress[]

  @@unique([slug, version])
  @@index([personalWordId, isCurrent])
}

model WordOption {
  id        String   @id @default(uuid()) @db.Uuid
  wordId    String   @db.Uuid
  position  Int
  text      String   @db.VarChar(80)
  isCorrect Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  word      Word     @relation(fields: [wordId], references: [id], onDelete: Restrict)

  @@unique([wordId, position])
  @@unique([wordId, text])
}

enum SessionMode {
  LEARN
  REVIEW
}

enum LearningState {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

enum SessionStatus {
  LEGACY
  ACTIVE
  COMPLETED
  EXPIRED
}

model StudySession {
  id           String         @id @db.VarChar(24)
  userId       BigInt
  chatId       BigInt
  messageId    BigInt?
  vocabularyMode VocabularyMode @default(GENERAL)
  cefrLevel CefrLevel?
  mode         SessionMode   @default(LEARN)
  status       SessionStatus @default(LEGACY)
  currentIndex Int           @default(0)
  revision     Int           @default(0)
  completedAt  DateTime?     @db.Timestamptz(3)
  syncedRevision Int         @default(-1)
  sendToken    String?       @db.VarChar(24)
  sendLeaseUntil DateTime?   @db.Timestamptz(3)
  learnRequests LearnRequest[]
  chatInstance String?        @db.VarChar(256)
  expiresAt    DateTime       @db.Timestamptz(3)
  revokedAt    DateTime?      @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  user         TelegramUser   @relation(fields: [userId], references: [id], onDelete: Restrict)
  items        SessionItem[]
  receipts     WidgetQueryReceipt[]

  @@unique([chatId, messageId])
  @@index([userId, createdAt])
  @@index([expiresAt])
}

model SessionItem {
  id         String         @id @default(uuid()) @db.Uuid
  sessionId  String         @db.VarChar(24)
  wordId     String         @db.Uuid
  position   Int
  optionOrder Int[]         @default([0, 1, 2, 3])
  revealedAt DateTime?      @db.Timestamptz(3)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)
  session    StudySession   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  word       Word           @relation(fields: [wordId], references: [id], onDelete: Restrict)
  attempt    ReviewAttempt?

  @@unique([sessionId, position])
  @@unique([sessionId, wordId])
  @@index([wordId])
}

model ReviewAttempt {
  id               String      @id @default(uuid()) @db.Uuid
  sessionItemId    String      @unique @db.Uuid
  // Null for reveal-first MCQ or self-review; selfRating distinguishes recall.
  selfRating Boolean?
  selectedPosition Int?
  correct          Boolean
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  latestProgress   UserWordProgress?
  item             SessionItem @relation(fields: [sessionItemId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model WidgetQueryReceipt {
  id          String       @id @db.VarChar(256)
  sessionId   String       @db.VarChar(24)
  fingerprint String       @db.Char(64)
  response    Json
  deliveredAt DateTime?    @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  session     StudySession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId])
  @@index([createdAt])
}

// Deduplicates /learn and /review webhook delivery, even after its session completes.
model LearnRequest {
  userId    BigInt
  messageId BigInt
  sessionId String       @db.VarChar(24)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@id([userId, messageId])
  @@index([sessionId])
}

model UserWordProgress {
  userId          BigInt
  wordId          String        @db.Uuid
  state           LearningState @default(NEW)
  repetitions     Int           @default(0)
  lapses          Int           @default(0)
  intervalMinutes Int           @default(0)
  dueAt           DateTime      @db.Timestamptz(3)
  lastReviewedAt  DateTime      @db.Timestamptz(3)
  lastAttemptId   String        @unique @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  user            TelegramUser  @relation(fields: [userId], references: [id], onDelete: Restrict)
  word            Word          @relation(fields: [wordId], references: [id], onDelete: Restrict)
  lastAttempt     ReviewAttempt @relation(fields: [lastAttemptId], references: [id], onDelete: Restrict)

  @@id([userId, wordId])
  @@index([userId, dueAt])
  @@index([wordId])
}


enum VocabularyMode {
  GENERAL
  PERSONAL
  MIXED
}

model PersonalWord {
  id String @id @default(uuid()) @db.Uuid
  ownerId BigInt
  termKey String @db.VarChar(80)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  owner TelegramUser @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  versions Word[]
  @@unique([ownerId, termKey])
  @@index([ownerId, archivedAt, createdAt])
}

model VocabularyDraft {
  userId BigInt @id
  token String @unique @db.VarChar(24)
  data Json
  promptMessageId BigInt?
  expiresAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user TelegramUser @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model VocabularyReceipt {
  userId BigInt
  messageId BigInt
  fingerprint String @db.Char(64)
  response Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user TelegramUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([userId, messageId])
}

// Approximate learning bands for curated shared catalog entries.
enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
}
