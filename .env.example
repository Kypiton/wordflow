TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_secret
TELEGRAM_WEBHOOK_URL=https://your-public-domain.example/api/telegram/webhook

# Provision PostgreSQL first; replace placeholders with provider-issued values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional direct connection for migrations/seed when DATABASE_URL is pooled.
DIRECT_URL=
# Put TEST_DATABASE_URL in .env.test.local for the guarded integration runner.
# Dedicated disposable Neon test branch only; never use production.
TEST_DATABASE_URL=
